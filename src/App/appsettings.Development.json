{
  "ConnectionStrings": {
    "Database": "Host=trainersphere-db;Port=5432;Database=trainersphere;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
        }
      }
    ]
  },
  "Modules": {
    "Users": {
      "BackgroundJobs": {
        "ProcessOutboxMessages": {
          "IntervalInSeconds": 10,
          "RetryCount": 1,
          "BatchSize": 5
        }
      }
    }
  }
}
