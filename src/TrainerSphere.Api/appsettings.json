{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5433;Database=trainersphere;Username=trainersphere;Password=trainersphere"
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDemoData": false
  },
  "Auth": {
    "Issuer": "trainersphere",
    "Audience": "trainersphere",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "RefreshCookieSecure": true
  },
  "App": {
    "WebBaseUrl": "http://localhost:5173"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "From": "TrainerSphere <no-reply@trainersphere.dev>"
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "RateLimiting": {
    "AuthPermitLimitPerMinute": 10
  },
  "Messaging": {
    "Enabled": true,
    "PollingIntervalMilliseconds": 1000,
    "BatchSize": 50,
    "MaxAttempts": 5
  }
}
