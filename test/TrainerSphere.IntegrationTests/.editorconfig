[*.cs]

# Test method names use underscores (Method_State_Expected).
dotnet_diagnostic.CA1707.severity = none

# xUnit discovers public test classes; fixtures injected into them must be public too.
dotnet_diagnostic.CA1515.severity = none

# Tests assert on literal values and build throwaway objects inline.
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA2000.severity = none

# Routes are written as string literals, exactly as the HTTP contract documents them.
dotnet_diagnostic.CA2234.severity = none
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none

# Test-side DTOs mirror the JSON wire format, including array-typed members.
dotnet_diagnostic.CA1819.severity = none
dotnet_diagnostic.CA1002.severity = none
