    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-query-persist-client": "^5.108.0",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.75.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
